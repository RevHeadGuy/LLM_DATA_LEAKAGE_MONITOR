{
  "manifest_version": 3,
  "name": "LLM Data Leakage Monitor",
  "version": "1.6",
  "description": "Detects and blocks sensitive data using regex and offline BERT-tiny NER model with page context injection.",
  "permissions": ["scripting", "activeTab", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "LLM Data Leakage Monitor"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "web_model/**",
        "wasm/*.wasm",
        "libs/transformers.min.js",
        "libs/page-injected-module.js",
        "dashboard.html",
        "dashboard.js",
        "popup.js"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
